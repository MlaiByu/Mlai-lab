# Mlai-Lab 环境变量示例
# 用法：cp .env.example .env && vi .env
# 说明：.env 已被 .gitignore 忽略，请勿把真实口令提交到仓库
# 本项目不加载 python-dotenv，本地开发用 `set -a && source .env && set +a`，
# 服务器部署在 systemd 服务单元的 [Service] 段使用 EnvironmentFile=/opt/Mlai-lab/.env

# Flask 会话密钥（生产环境务必替换，可用 openssl rand -hex 32 生成）
SECRET_KEY=change-me-to-a-random-secret

# 后端监听端口（config.py 读取；start.sh 另用 BACKEND_PORT/FRONTEND_PORT）
SERVER_PORT=8000

# 数据库连接（与创建数据库时设置的账号密码保持一致）
DB_HOST=localhost
DB_USER=mlai
DB_PASSWORD=change-me
DB_NAME=mlai_lab

# start.sh 本地开发端口
BACKEND_PORT=8000
FRONTEND_PORT=3000
